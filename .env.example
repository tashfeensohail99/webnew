# Base URL of the CRM backend. The site reads the ACTIVE WhatsApp channel from
# it at build time (GET /public/whatsapp/channel), so the CRM stays the single
# source of truth for the number every CTA opens. Change the channel in the admin
# panel and the site follows — no redeploy, no config edit here.
CRM_API_URL=

# Base URL of the CRM backend, exposed to the BROWSER. The consultation form
# (/book-consultation) POSTs leads to `${NEXT_PUBLIC_CRM_API_URL}/public/leads/website`
# from the client, so it needs the NEXT_PUBLIC_ prefix (CRM_API_URL above is
# server/build-time only and is NOT in the browser bundle). Usually the same
# host as CRM_API_URL. If unset, the form falls back to a hardcoded production
# URL in components/LeadForm.tsx — set this so leads can't silently go to a
# stale host.
NEXT_PUBLIC_CRM_API_URL=

# Local-dev escape hatch ONLY, for when the CRM isn't reachable.
# E.164 digits, no "+", e.g. 923350001111. Production should use CRM_API_URL.
NEXT_PUBLIC_WA_NUMBER=
